# foxclick configuration - shell syntax, sourced by ~/.local/bin/foxclick
# Edit, then just toggle again (no daemon to restart).

# hold  = press and hold the button down  (building, digging in Foxhole)
# click = repeated click events
MODE=hold

# click mode:
CPS=12            # clicks per second
JITTER=15         # +/- percent random variation on the interval (0 = perfectly steady)

BUTTON=1          # 1=left  2=middle  3=right

# hold mode: re-send the press every tick so a dropped press recovers.
# Set 0 for a single clean press.
REASSERT=1

# Which window to click. foxclick sends events straight to this one window by id
# (via xdotool --window), so they never touch any other window - Discord, the
# browser, Steam are all safe - and they don't follow or steal your focus.
WINDOW_CLASS="steam_app_505460"   # X window class (Foxhole = its Steam appid)
WINDOW_NAME=""                    # optional extra filter on the window name (regex)

# Force the X display, e.g. ":0". Empty = autodetect (your session's DISPLAY,
# then any X socket) and find the window on it.
X_DISPLAY=""

# Only enable if a modifier key you physically hold (Alt for push-to-talk, etc.)
# that also reaches the game is turning your clicks into modified clicks in-game.
# Sends a modifier-release to the game window only - never affects the modifier
# state of whatever you're really using on another window.
CLEARMODS=0

# Safety: auto-stop after this many seconds (0 = run until you stop it or the game closes)
MAX_SECONDS=0
