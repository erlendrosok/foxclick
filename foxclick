#!/usr/bin/env bash
# foxclick - focus-independent autoclicker for an XWayland game (Foxhole).
#
# Sends synthetic button events straight to the game's X window with
#   xdotool click --window <id>
# so building/digging keeps going while your real keyboard and mouse are on
# another window or monitor. The events go to that one window by id, not to
# whatever is focused, so they don't follow your focus and don't steal it.
#
# No gamescope, no nested display - the game runs as an ordinary (XWayland)
# window on your Wayland compositor.
#
# Requires: xdotool, and the game running as a normal window (NOT via gamescope).
#
# Usage:
#   foxclick toggle      start if stopped, stop if running   (bind this to a hotkey)
#   foxclick start | stop | status
#   foxclick calibrate   show the detected game window + fire 5 test clicks
#   foxclick log         print the diagnostic log from the last run
#
# Config: ~/.config/foxclick/config  (shell syntax, sourced)

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/foxclick/config"
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNDIR/foxclick.pid"
LOG="$RUNDIR/foxclick.log"

# ---- defaults (override in $CONFIG) ----
MODE=hold                     # hold = press and hold the button;  click = repeated clicks
CPS=12                        # clicks per second (click mode only)
JITTER=15                     # +/- percent random variation on the interval (click mode only)
BUTTON=1                      # X button: 1=left, 2=middle, 3=right
WINDOW_CLASS="steam_app_505460"  # X window class of the game (Foxhole's Steam appid class)
WINDOW_NAME=""                # optional: also require the window name to match this regex
X_DISPLAY=""                  # force the X display, e.g. ":0"; empty = autodetect
MAX_SECONDS=0                 # safety auto-stop after N seconds; 0 = no limit
REASSERT=1                    # hold mode: re-send the press every tick so a dropped press recovers
CLEARMODS=0                   # send a keyboard-modifier release to the game window before each
                             # click. Only enable if a modifier you hold on the keyboard
                             # (Alt for push-to-talk, etc.) is turning clicks into modified
                             # clicks in-game. Targets the game window only.

# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

ts() { date '+%H:%M:%S'; }
log() { printf '%s %s\n' "$(ts)" "$1" >>"$LOG"; }

note() {
    printf 'foxclick: %s\n' "$1" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -a foxclick -t 2500 "foxclick" "$1" >/dev/null 2>&1 || true
}
die() { note "$1"; exit 1; }

is_running() {
    local p
    [ -f "$PIDFILE" ] || return 1
    p="$(cat "$PIDFILE" 2>/dev/null)" || return 1
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# Candidate X displays: the configured/inherited one first, then every socket.
candidate_displays() {
    local seen=" " d
    for d in "$X_DISPLAY" "${DISPLAY:-}" ; do
        [ -n "$d" ] || continue
        case "$seen" in *" $d "*) ;; *) echo "$d"; seen="$seen$d " ;; esac
    done
    local sock
    for sock in /tmp/.X11-unix/X*; do
        [ -e "$sock" ] || continue
        d=":${sock##*/X}"
        d="${d%_}"        # ignore abstract-socket ".../X0_" style names
        case "$seen" in *" $d "*) ;; *) echo "$d"; seen="$seen$d " ;; esac
    done
}

# Echo the largest-area window of $WINDOW_CLASS (optionally name-filtered) on
# display $1, or nothing. The game's real window dwarfs its 1x1 / IME / tooltip
# helper windows, so "biggest wins" is a reliable pick.
find_window_on() {
    local disp="$1" w best="" bestA=0 a nm
    for w in $(DISPLAY="$disp" xdotool search --class "$WINDOW_CLASS" 2>/dev/null); do
        if [ -n "$WINDOW_NAME" ]; then
            nm="$(DISPLAY="$disp" xdotool getwindowname "$w" 2>/dev/null || true)"
            printf '%s' "$nm" | grep -Eq "$WINDOW_NAME" || continue
        fi
        unset WIDTH HEIGHT
        eval "$(DISPLAY="$disp" xdotool getwindowgeometry --shell "$w" 2>/dev/null || true)"
        a=$(( ${WIDTH:-0} * ${HEIGHT:-0} ))
        [ "$a" -gt "$bestA" ] && { bestA="$a"; best="$w"; }
    done
    [ -n "$best" ] && echo "$best"
}

# Print "DISPLAY WID" for the game window, searching every candidate display.
find_game() {
    local disp w
    while read -r disp; do
        [ -n "$disp" ] || continue
        DISPLAY="$disp" xdotool getdisplaygeometry >/dev/null 2>&1 || continue
        w="$(find_window_on "$disp")" || true
        [ -n "$w" ] && { echo "$disp $w"; return 0; }
    done < <(candidate_displays)
    return 1
}

interval() {
    awk -v c="$CPS" -v j="${JITTER:-0}" 'BEGIN{
        srand();
        b = (c > 0 ? 1.0/c : 0.08);
        f = 1 + (rand()*2 - 1) * j/100.0;
        v = b * f;
        if (v < 0.005) v = 0.005;
        printf "%.4f", v;
    }'
}

# The background worker. Not called directly by the user.
run() {
    local disp="$1" wid="$2" start held=0 fails=0 tick=0
    export DISPLAY="$disp"
    unset XAUTHORITY 2>/dev/null || true   # local Xwayland connection needs no cookie
    start="$(date +%s)"
    : >"$LOG"
    log "worker start  display=$disp wid=$wid mode=$MODE button=$BUTTON cps=$CPS class=$WINDOW_CLASS"
    echo "$$" >"$PIDFILE"

    # Release our button on the game window. Covers a press interrupted mid-hold
    # and anything a previous run left down. Buttons 1/2/3 for good measure.
    release_buttons() {
        local b
        for b in 1 2 3; do xdotool mouseup --window "$wid" "$b" >>"$LOG" 2>&1 || true; done
    }

    # Optional: tell the game window "modifiers are up" right before a click, so a
    # key you physically hold (Alt for push-to-talk, etc.) that also reaches the
    # game doesn't modify the click. Window-targeted, so it never touches the
    # modifier state of whatever you're really using on another window.
    clear_mods() {
        [ "${CLEARMODS:-0}" = 1 ] || return 0
        xdotool keyup --window "$wid" Alt_L Alt_R Control_L Control_R Shift_L Shift_R Super_L Super_R \
            >>"$LOG" 2>&1 || true
    }

    window_alive() { xdotool getwindowname "$wid" >/dev/null 2>&1; }

    # Try to re-find the game window (it changes id when the game switches between
    # windowed and fullscreen, or menu and world). Returns 0 and updates $wid.
    relocate() {
        local found
        found="$(find_window_on "$disp")" || true
        [ -n "$found" ] || return 1
        [ "$found" = "$wid" ] || log "window id changed $wid -> $found"
        wid="$found"
        return 0
    }

    # xdotool exits non-zero when the target window is gone (BadWindow). That is
    # the only failure worth reacting to, and checking the return of the click
    # itself means no extra X round-trips per tick (which contend with an
    # XWayland client that has focus).
    poke() {  # poke <click|down|up>
        local rc
        case "$1" in
            click) xdotool click     --window "$wid" "$BUTTON" >>"$LOG" 2>&1 ;;
            down)  xdotool mousedown  --window "$wid" "$BUTTON" >>"$LOG" 2>&1 ;;
            up)    xdotool mouseup    --window "$wid" "$BUTTON" >>"$LOG" 2>&1 ;;
        esac
        rc=$?
        [ "$rc" -eq 0 ] && { fails=0; return 0; }
        fails=$((fails + 1))
        return 1
    }

    local cleaned=0
    cleanup() {
        local rc=$?
        [ "$cleaned" = 1 ] && exit 0
        cleaned=1
        release_buttons
        log "released buttons on $wid"
        rm -f "$PIDFILE"
        log "worker exit (rc=$rc, ticks=$tick)"
        note "stopped"
        exit 0
    }
    trap cleanup INT TERM EXIT

    log "window: name='$(xdotool getwindowname "$wid" 2>&1)' geom='$(xdotool getwindowgeometry "$wid" 2>&1 | tr '\n' ' ')'"

    window_alive || { log "FATAL: game window $wid not found on $disp"; note "game window not found (foxclick log)"; exit 1; }

    release_buttons   # clean slate

    if [ "$MODE" = hold ]; then
        clear_mods
        poke down && held=1
        log "mousedown --window $wid button $BUTTON  (held=$held)"
    fi

    while :; do
        tick=$((tick + 1))

        if [ "${MAX_SECONDS:-0}" -gt 0 ] 2>/dev/null; then
            [ "$(( $(date +%s) - start ))" -ge "$MAX_SECONDS" ] && { log "MAX_SECONDS reached"; break; }
        fi

        if [ "$MODE" = click ]; then
            clear_mods
            poke click || log "click failed ($fails) at tick $tick"
            sleep "$(interval)"
        else
            if [ "${REASSERT:-1}" = 1 ] && [ "$held" = 1 ]; then
                poke down || log "re-assert failed ($fails) at tick $tick"
            fi
            sleep 1
        fi

        # Only when clicks actually start failing (window gone) do we spend X
        # round-trips trying to re-find it, then give up.
        if [ "$fails" -ge 5 ]; then
            if relocate; then
                fails=0
                log "recovered: now on window $wid"
                [ "$MODE" = hold ] && { clear_mods; poke down && held=1; }
            elif [ "$fails" -ge 20 ]; then
                log "giving up: game window gone ($fails consecutive failures)"
                break
            else
                sleep 0.4
            fi
        fi
    done
    cleanup
}

start() {
    is_running && { note "already running"; return 0; }
    command -v xdotool >/dev/null 2>&1 || die "xdotool not installed  ->  sudo pacman -S xdotool"
    local disp wid rest
    rest="$(find_game)" || die "game window not found - is $WINDOW_CLASS running as a normal window? (not gamescope)"
    disp="${rest%% *}"
    wid="${rest##* }"
    setsid -f "$SELF" __run "$disp" "$wid" </dev/null >/dev/null 2>&1
    sleep 0.4
    if is_running; then
        note "ON - $MODE, button $BUTTON, window $wid on $disp"
    else
        note "failed to start - run: foxclick log"
        exit 1
    fi
}

stop() {
    local p
    if is_running; then
        p="$(cat "$PIDFILE")"
        kill "$p" 2>/dev/null
        for _ in $(seq 30); do is_running || break; sleep 0.1; done
        is_running && kill -9 "$p" 2>/dev/null
    else
        note "not running"
    fi
    rm -f "$PIDFILE"
    # belt & suspenders: release every button on the game window in case a press
    # was interrupted mid-hold (otherwise the game thinks the button is stuck).
    local rest disp wid b
    rest="$(find_game 2>/dev/null || true)"
    if [ -n "$rest" ]; then
        disp="${rest%% *}"; wid="${rest##* }"
        for b in 1 2 3; do DISPLAY="$disp" xdotool mouseup --window "$wid" "$b" >/dev/null 2>&1 || true; done
    fi
}

status() {
    if is_running; then
        echo "running (pid $(cat "$PIDFILE"), mode=$MODE, cps=$CPS, button=$BUTTON)"
    else
        echo "stopped"
    fi
    [ -f "$LOG" ] && { echo "--- last run log ---"; cat "$LOG"; }
}

calibrate() {
    command -v xdotool >/dev/null 2>&1 || die "xdotool not installed  ->  sudo pacman -S xdotool"
    echo "config             : class='$WINDOW_CLASS' name='${WINDOW_NAME:-any}' button=$BUTTON mode=$MODE"
    echo "candidate displays : $(candidate_displays | tr '\n' ' ')"
    local rest disp wid
    rest="$(find_game)" || die "game window not found - is $WINDOW_CLASS running as a normal window? (not gamescope)"
    disp="${rest%% *}"; wid="${rest##* }"
    echo
    echo "chosen display     : $disp"
    echo "game window        : $wid  name='$(DISPLAY="$disp" xdotool getwindowname "$wid" 2>&1)'"
    echo "geometry           : $(DISPLAY="$disp" xdotool getwindowgeometry "$wid" 2>&1 | tr '\n' ' ')"
    echo
    echo "firing 5 test ${BUTTON}-clicks at that window in 2s (focus stays where it is)..."
    sleep 2
    local i
    for i in 1 2 3 4 5; do DISPLAY="$disp" xdotool click --window "$wid" "$BUTTON"; sleep 0.4; done
    echo "done - did the game register all 5?"
}

case "${1:-toggle}" in
    toggle)     is_running && stop || start ;;
    start)      start ;;
    stop)       stop ;;
    status)     status ;;
    calibrate)  calibrate ;;
    log)        [ -f "$LOG" ] && cat "$LOG" || echo "no log yet ($LOG)" ;;
    __run)      shift; run "${1:-}" "${2:-}" ;;
    -h|--help|help)
        sed -n '2,21p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "usage: foxclick [toggle|start|stop|status|calibrate|log]" >&2
        exit 2 ;;
esac
